{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://utkarsh5026.github.io/",
  "scripts": {
    "prepare": "cd .. && husky",
    "gen:git-stats": "bun ../scripts/generate-git-stats.js",
    "gen:git-commits": "bun ../scripts/generate-git-commits.js",
    "gen:git-meta": "bun ../scripts/generate-git-meta.js",
    "gen:activity": "bun ../scripts/generate-activity-feed.js",
    "dev": "vite",
    "watch": "vite --port 3000 --strictPort",
    "watch:prod": "bun ../scripts/watch-prod.js",
    "build": "tsc -b && vite build",
    "force-build": "bunx tsc --build --force && vite build --force",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "analyze:verbose": "ANALYZE=true vite build"
  },
  "dependencies": {
    "@fontsource/cascadia-code": "^5.2.3",
