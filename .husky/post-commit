#!/usr/bin/env sh
# .husky/post-commit
# Regenerates git JSON files after every commit so they reflect the latest commit.
# Husky runs this automatically — no manual setup needed.

set -e

echo "⚙  Regenerating git-stats.json..."
node scripts/generate-git-stats.js

echo "⚙  Regenerating git-commits.json..."
node scripts/generate-git-commits.js

echo "⚙  Regenerating git-meta.json (component-level blame)..."
node scripts/generate-git-meta.js

git add app/public/git-stats.json app/public/git-commits.json app/public/data/git-meta.json
echo "✓  JSON files updated and staged"

git commit --amend --no-edit --no-verify
echo "✓  Amended commit with updated JSON files"
