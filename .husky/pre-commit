#!/usr/bin/env sh
# .husky/pre-commit
# Regenerates git-stats.json and git-commits.json before every commit.
# Husky runs this automatically — no manual setup needed.

set -e

echo "⚙  Regenerating git-stats.json..."
node scripts/generate-git-stats.js

echo "⚙  Regenerating git-commits.json..."
node scripts/generate-git-commits.js

git add app/public/git-stats.json app/public/git-commits.json
echo "✓  JSON files updated and staged"

echo "🔍  Running lint..."
cd app && bun run lint
echo "✓  Lint passed"

echo "🔎  Running type check..."
bun run typecheck
echo "✓  Type check passed"

echo "💅  Running Prettier check..."
bun run format:check
echo "✓  Prettier check passed"
