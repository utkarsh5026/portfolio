#!/usr/bin/env sh
# .husky/pre-commit
# Runs lint, type check, and prettier before every commit.
# Husky runs this automatically — no manual setup needed.

set -e

echo "🔍  Running lint..."
cd app && bun run lint
echo "✓  Lint passed"

echo "🔎  Running type check..."
bun run typecheck
echo "✓  Type check passed"

echo "💅  Running Prettier check..."
bun run format:check
echo "✓  Prettier check passed"
